{
  "_source": [
    "product_id",
    "product_name",
    "brand",
    "category",
    "personal_color",
    "skin_type",
    "price",
    "rating",
    "tags"
  ],
  "query": {
    "multi_match": {
      "query": "{{searchText}}",
      "fields": ["product_name^3", "tags"]
    }
  },
  "highlight": {
    "pre_tags": ["<mark>"],
    "post_tags": ["</mark>"],
    "fields": {
      "product_name": {},
      "tags": {}
    }
  },
  "sort": [
    { "_score": "desc" },
    { "rating": "desc" }
  ]
}
